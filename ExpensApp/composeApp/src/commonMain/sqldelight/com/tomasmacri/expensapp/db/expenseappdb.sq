selectAll:
SELECT * FROM ExpenseEntity;

insert:
INSERT INTO ExpenseEntity (name, amount, category, description) VALUES (?, ?, ?, ?);

update:
UPDATE ExpenseEntity SET name = ?, amount = ?, category = ?, description = ? WHERE id = ?;

delete:
DELETE FROM ExpenseEntity WHERE id = ?;

