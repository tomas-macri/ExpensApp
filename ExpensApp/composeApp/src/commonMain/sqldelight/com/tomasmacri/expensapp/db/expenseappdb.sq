CREATE TABLE ExpenseEntity  (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    amount REAL NOT NULL,
    category TEXT NOT NULL,
    description TEXT NOT NULL
);

INSERT INTO ExpenseEntity (name, amount, category, description) VALUES
